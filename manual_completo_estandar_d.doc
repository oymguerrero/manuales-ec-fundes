<desc id="svg-mapa-d-desc">El Estándar D se compone de cuatro elementos secuenciales: Diagnosticar (Elemento 1), Construir (Elemento 2), Implementar (Elemento 3) y Optimizar (Elemento 4). Forman el ciclo completo de desarrollo de soluciones de transformación digital con IA.</desc>
<defs>
<marker id="arrow-mapa-d" markerheight="10" markerwidth="10" orient="auto" refx="11" refy="6" viewbox="0 0 12 12">
<path d="M 0 0 L 12 6 L 0 12 z" fill="#28467e"></path>
</marker>
</defs>
