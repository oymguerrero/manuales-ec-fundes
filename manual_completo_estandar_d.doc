<text fill="#FAFCFF" font-family="Afacad, Inter, sans-serif" font-size="10" text-anchor="middle" x="100" y="172">elaboras propuesta</text>
<text fill="#FAFCFF" font-family="Afacad, Inter, sans-serif" font-size="10" text-anchor="middle" x="100" y="186">y obtienes autorización</text>
</g>
<!-- Flecha 1 → 2 -->
<line marker-end="url(#arrow-mapa-d)" stroke="#28467e" stroke-width="3" x1="230" x2="255" y1="150" y2="150"></line>
