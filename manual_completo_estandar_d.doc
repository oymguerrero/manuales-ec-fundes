    style G fill:#FFFBEA,stroke:#f7c031,color:#28467e
    style H fill:#FAFCFF,stroke:#8DA4BF,color:#28467e
    style I fill:#FAFCFF,stroke:#8DA4BF,color:#28467e</pre>
</div>
</div>
</details>
