    C --&gt; E["Motor IA\nPredicción de demanda"]
    D --&gt; F["Dashboard\nRutas del día"]
    E --&gt; G["Dashboard\nInventario sugerido"]
    F --&gt; H["Repartidores\nmóvil"]
    G --&gt; I["Raúl\ngerente"]

    style A fill:#EAF4FF,stroke:#529ed7,color:#28467e
